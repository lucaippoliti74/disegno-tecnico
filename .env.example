# Copiare in .env. Conservare i segreti solo nell'ambiente del backend.
FRONTEND_ORIGIN=http://127.0.0.1:4173
TEACHER_TOKEN_HASHES=
QUOTA_DB=./quote.sqlite
HOST=127.0.0.1
PORT=8787

# openai (Responses) oppure openai-compatible (Chat Completions).
# mock richiede una fixture iniettata nei test.
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
AI_COMPLEX_MODEL=gpt-4.1
AI_API_KEY=
# URL di base con versione, obbligatorio per openai-compatible.
# Esempio Ollama sullo stesso host: http://127.0.0.1:11434/v1
# AI_BASE_URL=
AI_TIMEOUT_MS=100000
AI_MAX_OUTPUT_TOKENS=6500
# Solo openai-compatible. Usare false se il server non accetta response_format.
# AI_CHAT_JSON_MODE=true
# AI_CHAT_TOKEN_FIELD=max_tokens
